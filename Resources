<style>
body {
    font-family: "Segoe UI", sans-serif;
    margin: 0;
    background-color: #f9fafb;
    color: #1f2937;
}

.container {
    max-width: 900px;
    margin: auto;
    padding: 40px 20px;
}

/* Navbar */
.navbar {
    background-color: #1f2937;
}
.navbar ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
}
.navbar li a {
    display: block;
    color: #fff;
    padding: 16px 20px;
    text-decoration: none;
}
.navbar li a:hover,
.navbar li a.active {
    background-color: #2563eb;
}

/* Header */
.header {
    text-align: center;
    padding: 50px 20px 20px;
}
.header h1 {
    margin: 0;
    font-size: 2.2rem;
}
.header p {
    color: #6b7280;
    margin-top: 10px;
}

/* Section */
.section-title {
    margin-top: 40px;
    font-size: 1.4rem;
    border-left: 4px solid #2563eb;
    padding-left: 10px;
}

/* Cards */
.course-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    margin-top: 20px;
}

.course-card {
    background: #fff;
    padding: 20px 25px;
    border-radius: 10px;
    box-shadow: 0 4px 10px rgba(0,0,0,0.05);
    transition: transform 0.2s, box-shadow 0.2s;
}

.course-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 20px rgba(0,0,0,0.08);
}

.course-card a {
    text-decoration: none;
    color: #2563eb;
    font-weight: 600;
    font-size: 1.1rem;
}

.course-card span {
    display: block;
    margin-top: 5px;
    color: #6b7280;
    font-size: 0.9rem;
}
</style>


</head>
